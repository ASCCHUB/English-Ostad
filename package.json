{
  "name": "english-ustad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/offline-manifest.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none src/ustad/*.test.js",
    "audit:language": "node scripts/audit-support-language.mjs ur --max=0 && node scripts/audit-support-language.mjs ps --max=0",
    "pashto:audio": "node scripts/pashto-audio-status.mjs",
    "first-steps:build": "node scripts/build-first-steps.mjs",
    "first-steps:check": "node scripts/build-first-steps.mjs --check",
    "recordings:add": "node scripts/add-recordings.mjs",
    "release:check": "node scripts/add-recordings.mjs --release",
    "course:audit": "node scripts/audit-taught-words.mjs",
    "android:apk": "node scripts/android-apk.mjs",
    "android:aab": "node scripts/android-aab.mjs",
    "games:build": "node scripts/build-game-bank.mjs",
    "games:check": "node scripts/check-game-bank.mjs",
    "voice:pk": "node scripts/make-pk-voice.mjs",
    "check:pages": "node scripts/build-pages.mjs && node scripts/check-pages-offline-retry.mjs chromium && node scripts/check-pages-offline-retry.mjs iphone"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@supabase/supabase-js": "^2.111.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.25",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  }
}
